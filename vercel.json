{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.propstrack.com"
        }
      ],
      "destination": "/web/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(stats|stats-bento|stats-mission)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
