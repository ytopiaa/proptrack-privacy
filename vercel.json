{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.propstrack.com"
        }
      ],
      "destination": "/web/index.html"
    }
  ],
  "headers": [
    {
      "source": "/stats.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/stats-bento.html",
      "destination": "/stats.html",
      "permanent": false
    },
    {
      "source": "/stats-mission.html",
      "destination": "/stats.html",
      "permanent": false
    }
  ]
}
